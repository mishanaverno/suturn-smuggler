.hint-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    flex-wrap: wrap;
    padding: 4px 12px;
    background-color: rgba(8, 14, 12, 0.75);
    -unity-font: url("project://database/Assets/TextMesh%20Pro/Fonts/JetBrainsMono-Regular.ttf");
}

.hint-bar__item {
    flex-direction: row;
    align-items: center;
    margin-right: 18px;
}

.hint-bar__icon {
    width: 22px;
    height: 22px;
    -unity-background-image-tint-color: rgb(200, 235, 220);
}

.hint-bar__action {
    margin-left: 4px;
    font-size: 12px;
    color: rgb(200, 235, 220);
}

.hint-bar__icon--w { background-image: url("project://database/Assets/UI/kenney_input-prompts_1.5/Keyboard%20%26%20Mouse/Default/keyboard_w_outline.png"); }
.hint-bar__icon--a { background-image: url("project://database/Assets/UI/kenney_input-prompts_1.5/Keyboard%20%26%20Mouse/Default/keyboard_a_outline.png"); }

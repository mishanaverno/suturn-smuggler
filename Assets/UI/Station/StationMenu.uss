.station-menu {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.45);
    -unity-font: url("project://database/Assets/TextMesh%20Pro/Fonts/JetBrainsMono-Regular.ttf");
}

.station-menu--hidden {
    display: none;
}

.station-menu__panel {
    width: 520px;
    flex-shrink: 0;
    padding: 24px;
    background-color: rgb(8, 14, 12);
    border-width: 2px;
    border-color: rgb(90, 200, 160);
}

.station-menu__title {
    font-size: 28px;
    color: rgb(90, 200, 160);
    margin-bottom: 16px;
}

.station-menu__section {
    font-size: 16px;
    color: rgb(60, 130, 105);
    margin-bottom: 8px;
}

.station-menu__row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.station-menu__row--hidden {
    display: none;
}

.station-menu__label {
    width: 70px;
    font-size: 18px;
    color: rgb(90, 200, 160);
}

.station-menu__value {
    flex-grow: 1;
    font-size: 18px;
    color: rgb(200, 235, 220);
}

.station-menu__actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 16px;
}

.station-menu__button {
    min-width: 110px;
    margin-left: 8px;
    padding: 6px 12px;
    font-size: 18px;
    color: rgb(90, 200, 160);
    background-color: rgb(16, 32, 26);
    border-width: 1px;
    border-color: rgb(90, 200, 160);
    border-radius: 0;
}

.station-menu__button:hover {
    background-color: rgb(28, 60, 48);
}

.station-menu__button:disabled {
    color: rgb(50, 90, 75);
    border-color: rgb(40, 80, 65);
}
